# Copiar como .env. Completar SOLO en el equipo/servidor de la institución.
AI_PROVIDER=openai-compatible
# URL base HTTPS, normalmente termina en /v1. No agregar /chat/completions.
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
# Opcional: otros identificadores autorizados, separados por coma.
AI_ALLOWED_MODELS=
AI_AUTH_HEADER=Authorization
AI_TOKEN_PARAMETER=max_tokens
AI_SEND_TEMPERATURE=true
AI_MAX_TOKENS=2048
AI_TEMPERATURE=0.2
AI_TIMEOUT_MS=120000
# Solo para Anthropic. Ver docs/PROVEEDORES.md.
AI_API_VERSION=2023-06-01
# Ajustes específicos del proveedor; JSON de una sola línea entre comillas simples.
AI_EXTRA_BODY_JSON='{}'

HOST=127.0.0.1
PORT=8765
# Al escuchar en red, configurar ambos. El código de acceso debe tener >=24 caracteres.
PUBLIC_ORIGIN=
APP_ACCESS_TOKEN=
RATE_LIMIT_PER_MINUTE=20
MAX_CONCURRENT_REQUESTS=4
